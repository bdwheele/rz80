WMASC:  PRINT:PRINT "WMASC: CONVERT WM -> ASC" :PRINT                PG   1

100 PRINT:PRINT "WMASC: CONVERT WM -> ASC" :PRINT
110 DIM ASC.LINE$(65)	'Buffer output
120 LFCR$=CHR$(10)+CHR$(13)
130 LINE INPUT; "FILE:";F$
140 IF F$="" THEN END
150 OPEN "O",#2,F$+".ASC"
160 OPEN "I",#1,F$+".WM"
170 FOR L%=1 TO 64
175	ASC.LINE$(L%)=""
180	IF EOF(1) THEN GOTO 210
190	LINE INPUT #1,WM.LINE$
200	IF RIGHT$(WM.LINE$,1)="\"
		THEN
		ASC.LINE$(L%)=ASC.LINE$(L%)+
		LEFT$(WM.LINE$,LEN(WM.LINE$)-1)+
		LFCR$ :GOTO 180
		ELSE
		ASC.LINE$(L%)=ASC.LINE$(L%)+WM.LINE$
205	NEXT L%
210 FOR K%=1 TO L%-1
220	PRINT #2,ASC.LINE$(K%)
230	NEXT K% : IF EOF(1)
			THEN CLOSE :PRINT CHR$(7);"      Complete..."
			    :GOTO 130
			ELSE GOTO 170







































