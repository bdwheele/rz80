100 PRINT:PRINT "ASCWM: CONVERT ASC -> WM" :PRINT
110 DIM ASC.LINE$(64)	'Buffer input
120 LFCR$=CHR$(10)+CHR$(13)
130 LINE INPUT; "FILE:";F$
140 IF F$="" THEN END
150 OPEN "O",#2,F$+".WM"
160 OPEN "I",#1,F$+".ASC"
170 FOR K%=1 TO 64
180	IF EOF(1) THEN GOTO 210
190	LINE INPUT #1,ASC.LINE$(K%)
200	NEXT K%
210 FOR L%=1 TO K%-1
220	J%=1
230	I%=INSTR(J%,ASC.LINE$(L%),LFCR$)
240	IF I%<>0
		THEN
		PRINT #2,MID$(ASC.LINE$(L%),J%,I%-J%);"\" :
		J%=I%+2 :GOTO 230
		ELSE
		PRINT #2,MID$(ASC.LINE$(L%),J%)
250	NEXT L% : IF EOF(1)
			THEN CLOSE :PRINT CHR$(7);"      Complete..."
			    :GOTO 130
			ELSE GOTO 170
.LINE$(L%